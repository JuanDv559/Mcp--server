        content:
            `No se encontró el archivo ${archivoSolicitado}. ` +
            "No inventes su contenido ni afirmes haberlo leído. " +
            "Explica que no se encontró."
    });

    respuestaFinal = true;
    break;
}

    respuestaFinal = true;
    break;
}
            
if (!decision.tool) {
    // Si no hay una herramienta solicitada, aceptar la respuesta final
    // únicamente cuando no quede un archivo pendiente de leer.
    if (rutaEncontrada && !archivoLeido) {
